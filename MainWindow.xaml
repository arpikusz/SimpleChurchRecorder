<Window x:Class="SimpleChurchRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleChurchRecorder"
        mc:Ignorable="d"
        Title="HJC Senta Recorder" Height="450" Width="800"
        Icon="pack://application:,,,/Resources/rec.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="6" BorderBrush="#FFBDBDBD" BorderThickness="1" Background="#FFF2F2F2" Padding="12">
            <Button x:Name="RecordButton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="RecordLabel" Text="RECORD" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <DockPanel Margin="0,4">
                <TextBlock Width="60" VerticalAlignment="Center">Input:</TextBlock>
                <ComboBox x:Name="InputDevicesCombo" MinWidth="300" HorizontalAlignment="Left" />
            </DockPanel>
            <DockPanel Margin="0,8">
                <TextBlock Width="60" VerticalAlignment="Center">Output:</TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathBox" MinWidth="300" IsReadOnly="True" Grid.Column="0" />
                    <Button x:Name="EditOutputButton" Grid.Column="1" Width="28" Height="24" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Edit">
                        <TextBlock x:Name="EditOutputIcon" Text="✎" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </DockPanel>
        </StackPanel>

        <TextBlock x:Name="StatusLabel" Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Center" />
    </Grid>
</Window>
